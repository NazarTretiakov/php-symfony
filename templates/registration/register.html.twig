{% extends 'base.html.twig' %}


{% block title %}Registration{% endblock %}


{% block styles %}
    <link rel="stylesheet" type="text/css" href="{{ asset('/css/registration.css') }}"/>
{% endblock %}

{%  block javascripts %}
    <script src="{{ asset('js/home.js') }}"></script>
{% endblock %}

{% block header %}
    <header class="header">
        <ul class="header-elements">
            <li class="header-elements-logo"><a href="{{ path('app_home') }}"><img class="header-elements-logo-image" src="{{ source('img/Webpage_logo.png')|data_uri }}" alt="Webpage logo"></a></li>
            <li class="header-elements-security">
                <ul class="header-elements-security-elements">
                        <li class="header-elements-security-elements-login"><a style="font-size: 20px; color: white; text-decoration: none;" href=""></a></li>
                        <li class="header-elements-security-elements-register"><a style="font-size: 20px; color: white; text-decoration: none;" href="{{ path('app_login') }}">Login</a></li>
                </ul>
            </li>
        </ul>
    </header>
{% endblock %}

{% block body %}
    <h2 style="margin-left: 690px; margin-top: 100px; font-size: 36px">Registration</h2>

    <div class="container">
        {{ form_errors(registrationForm) }}

        {{ form_start(registrationForm) }}

        <div class="form-group">
            {{ form_row(registrationForm.name) }}
        </div>
        <div class="form-group">
            {{ form_row(registrationForm.lastname) }}
        </div>
        <div class="form-group">
            {{ form_row(registrationForm.email) }}
        </div>
        <div class="form-group">
            {{ form_row(registrationForm.plainPassword, {
                label: 'Password'
            }) }}
        </div>
        <div class="form-group-roles">
            {{ form_row(registrationForm.roles) }}
        </div>
        <div class="form-group form-group-agree-terms">
            {{ form_row(registrationForm.agreeTerms) }}
        </div>
        <div class="form-group">
            <button type="submit" class="btn">Register</button>
        </div>

        {{ form_end(registrationForm) }}
    </div>
{% endblock %}

{% block footer %}
    <footer class="footer">
        <a style="text-decoration: none" href="{{ path('app_about_us') }}"><span class="footer-about-us">About us</span></a>
    </footer>
{% endblock %}
